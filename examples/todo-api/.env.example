# Postgres, as postgres://user:password@host:port/database. This is the database the
# repository's podman-compose.yml starts. With no DB_URL, a development build uses
# postgres://postgres:postgres@localhost:5432/todo_api_development.
DB_URL=postgres://axa:axa@localhost:5432/axa_development

# The port to listen on.
PORT=1241
