# Postgres, as postgres://user:password@host:port/database. Connect as a role that is
# not a superuser and has no BYPASSRLS, or row-level security does not apply.
DB_URL=postgres://todo_app:todo_app@localhost:5432/axa_development

# The auth service's public key set, a JSON document with a "keys" array, and the
# issuer and audience its tokens carry.
PASETO_KEYS_FILE=./keys.json
PASETO_ISSUER=authentication-service
PASETO_AUDIENCE=multi-tenant

# The port to listen on.
PORT=1241
