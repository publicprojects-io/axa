#!/bin/sh
# Measure test coverage with cargo-tarpaulin, as tarpaulin.toml sets, and commit the
# report in docs/coverage. Extra arguments go to the tests, so with the AXA_TEST_ URLs
# set, `bin/test-coverage --include-ignored --test-threads=1` adds the database tests.
set -euf
BASE=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P) && cd "$BASE"
dst="docs/coverage"
cargo tarpaulin --config tarpaulin.toml -- "$@"
git add -- "$dst"
git commit -m "Update $dst" -- "$dst"
